# Configurações do Firebase para a Vitrine Virtual (Dinha Moda & Crochê)
# Substitua com as credenciais do seu projeto Firebase Console:
VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# WhatsApp padrão da Loja para finalização de pedidos (formato internacional: DDI + DDD + Número)
VITE_WHATSAPP_NUMBER=5511999999999
VITE_STORE_NAME=Dinha Crochê & Moda
